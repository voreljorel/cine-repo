
<?xml version="1.0" encoding="UTF-8"?>
<addon id="repository.cinemakitty"
       name="CinemaKitty Repo"
       version="1.0.0"
       provider-name="Fantomas">
    <requires>
        <import addon="xbmc.addon" version="12.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository"
               name="CinemaKitty Repository">
        <dir>
            <info>https://voreljorel.github.io/cinemakitty-repo/addons.xml</info>
            <checksum>https://voreljorel.github.io/cinemakitty-repo/addons.xml.md5</checksum>
            <datadir>https://voreljorel.github.io/cinemakitty-repo/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="cs">Oficiální repozitář pro doplněk CinemaKitty</summary>
        <description lang="cs">Repozitář obsahující doplněk CinemaKitty a jeho budoucí aktualizace.</description>
        <platform>all</platform>
        <logo>resources/icon.png</logo>
        <fanart>resources/fanart.jpg</fanart>
    </extension>
</addon>